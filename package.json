{
  "name": "money-coach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.mts",
    "typecheck": "tsc --noEmit",
    "preview:build": "npx --yes esbuild@0.24.0 preview/entry.tsx --bundle --minify --format=iife --jsx=automatic --target=es2020 --tsconfig=tsconfig.json --alias:next/link=./preview/shims/link.tsx --alias:next/image=./preview/shims/image.tsx --alias:next/navigation=./preview/shims/navigation.ts --define:process.env.NODE_ENV='\"production\"' --banner:js='var process={env:{NEXT_PUBLIC_DISABLE_FORMS:\"1\"}};' --outfile=preview/out/app.js && python3 preview/build.py"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
